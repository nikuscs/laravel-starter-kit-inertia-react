{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(jq -r '.tool_input.file_path') && if [[ \"$FILE\" == *.php ]]; then pint --quiet \"$FILE\" 2>/dev/null; fi"
          }
        ]
      }
    ]
  }
}
